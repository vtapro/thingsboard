#
# Cau hinh dev local tren macOS (Homebrew). Duoc `scripts/start-tb.sh` source tu dong.
# Sua file nay thay vi sua thingsboard.yml de giu nguyen config goc cua upstream.

# --- JDK 25 (pom.xml yeu cau `release 25`; Lombok 1.18.46 khong chay duoc tren JDK 27) ---
# Luon uu tien JDK 25 neu co, vi shell nguoi dung thuong dat JAVA_HOME=openjdk 27 (Homebrew).
# Build bang JDK 27 se chet giua duong va de lai class files loi (vi du thieu @Lazy tren tham so
# constructor cua Lombok => Spring bao "circular dependency" du allow-circular-references=true).
if [[ -x "$HOME/jdk25/Contents/Home/bin/java" ]]; then
    export JAVA_HOME="$HOME/jdk25/Contents/Home"
else
    export JAVA_HOME="${JAVA_HOME:-$HOME/jdk25/Contents/Home}"
fi

# --- Cong HTTP cua backend ---
# Doi lai bang cach export HTTP_BIND_PORT truoc khi goi script.
export HTTP_BIND_PORT="${HTTP_BIND_PORT:-8080}"

# --- PostgreSQL (brew install postgresql@18) ---
# Khong co role `postgres` tren may nay; role superuser la `geiq` (khong mat khau, trust local).
export SPRING_DATASOURCE_URL="jdbc:postgresql://localhost:5432/thingsboard"
export SPRING_DATASOURCE_USERNAME="geiq"
export SPRING_DATASOURCE_PASSWORD=""

# --- Redis (brew install redis) ---
# /opt/homebrew/etc/redis.conf co `requirepass greeniq_local_redis`.
export REDIS_HOST="localhost"
export REDIS_PORT="6379"
export REDIS_PASSWORD="greeniq_local_redis"

# --- Queue + timeseries: dung PostgreSQL cho ca hai, khong can Kafka/ZooKeeper/Cassandra ---
# Ly do bo Cassandra: ban CE khong hien thuc findAllKeysByEntityIds(Async) trong
# CassandraBaseTimeseriesLatestDao (stub tra rong) => widget dashboard khong liet ke duoc
# key telemetry. Chi bat lai khi that su can do hieu nang production-like.
export TB_QUEUE_TYPE="in-memory"
export DATABASE_TS_TYPE="sql"
export DATABASE_TS_LATEST_TYPE="sql"

# --- RBAC: bat de test cac tinh nang phan quyen cua fork nay ---
export SECURITY_RBAC_ENABLED="true"

# --- Cache: caffeine (giong production k3s, khong phu thuoc Redis cho cache) ---
export CACHE_TYPE="caffeine"
export MANAGEMENT_HEALTH_REDIS_ENABLED="false"

# --- RocksDB cho EDQS + calculated fields ---
# Mac dinh ${user.home}/.rocksdb co the bi loi quyen; tro vao target/ cua repo.
export TB_ROCKSDB_DIR="$PWD/application/target/rocksdb"
